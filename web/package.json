{
  "name": "jdownloader-web",
  "type": "module",
  "version": "26.11.1",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "start": "bun src/server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/server/db/migrate.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@corvu/drawer": "^0.2.4",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@iconify-json/tabler": "^1.2.43",
    "@kobalte/core": "^0.13.14",
    "@shadcn/lint": "^0.2.3",
    "@solidjs/router": "^1.0.1",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@unocss/preset-icons": "^66.12.0",
    "@unocss/preset-wind4": "^66.12.0",
    "@unocss/transformer-directives": "^66.12.0",
    "@unocss/transformer-variant-group": "^66.12.0",
    "concurrently": "^10.0.6",
    "cva": "^1.0.0-beta.12",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "solid-js": "^1.9.18",
    "somoto": "0.0.2",
    "tailwind-merge": "^3.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "unocss": "^66.12.0",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15"
  }
}
